@model IEnumerable<ConferenceSystem.Models.AttendeeVisit>

@{
    ViewData["Title"] = "Attendee Monitoring";
    var totalCount = Model.Count();
    var presentCount = Model.Count(a => a.Status == ConferenceSystem.Models.AttendeeStatus.Present);
    var leftCount = Model.Count(a => a.Status == ConferenceSystem.Models.AttendeeStatus.LeftEvent);
}

<div class="py-4">
    <!-- Header & Action Row -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Conference Dashboard</h2>
            <p class="text-muted small mb-0">Real-time tracking and monitoring panel for event staff.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i> Register Attendee
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill px-3 shadow-sm" title="Sign Out">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Total Checked-In</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Currently Present</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@presentCount</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-4 border-secondary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold">Left Event</span>
                        <h3 class="fw-bold text-secondary mb-0 mt-1">@leftCount</h3>
                    </div>
                    <div class="bg-secondary bg-opacity-10 text-secondary p-3 rounded-circle">
                        <i class="bi bi-person-dash fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Data Panel -->
    <div class="card shadow-lg border-0 rounded-4 p-4 bg-white">
        <!-- Search Form Bar -->
        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-light border-end-0 rounded-start-pill ps-3 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-light bg-light rounded-end-pill py-2" placeholder="Search by attendee name, ticket number, or organization..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 shadow-sm fw-semibold">
                    Search Filter
                </button>
            </div>
        </form>

        <!-- Attendees Table -->
        <div class="table-responsive rounded-3 border border-light">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="ps-3 py-3">Ticket</th>
                        <th class="py-3">Attendee Information</th>
                        <th class="py-3">Organization</th>
                        <th class="py-3">Check-In Time</th>
                        <th class="py-3">Status</th>
                        <th class="text-end pe-3 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="my-3">
                                    <i class="bi bi-folder2-open display-4 text-secondary opacity-50"></i>
                                    <p class="mt-2 mb-0">No attendance records found in the system.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary font-monospace">@item.TicketNumber</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.FirstName @item.LastName</div>
                                    <div class="text-muted small"><i class="bi bi-envelope-at me-1"></i>@item.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.Organization</span>
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-clock me-1"></i>@item.CheckInTime.ToString("MMM dd, yyyy - hh:mm tt")
                                </td>
                                <td>
                                    @if (item.Status == ConferenceSystem.Models.AttendeeStatus.Present)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fw-semibold">
                                            <i class="bi bi-dot"></i> Present
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 fw-semibold">
                                            Left Event
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group shadow-sm rounded-pill bg-light p-1" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm border-0 rounded-circle mx-1" title="View Full Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm border-0 rounded-circle mx-1" title="Edit Record">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (item.Status == ConferenceSystem.Models.AttendeeStatus.Present)
                                        {
                                            <a asp-action="Checkout" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm border-0 rounded-circle mx-1" title="Check-Out Attendee">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>