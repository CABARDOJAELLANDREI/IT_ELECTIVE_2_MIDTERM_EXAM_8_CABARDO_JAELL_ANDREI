@model ConferenceSystem.Models.AttendeeVisit

@{
    ViewData["Title"] = "Register Attendee";
}

<div class="card shadow-lg border-0 rounded-4 p-4 p-sm-5 bg-white">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
            <i class="bi bi-person-badge fs-3"></i>
        </div>
        <div>
            <h3 class="fw-bold text-dark mb-1">Register Attendee Arrival</h3>
            <p class="text-muted small mb-0">Fill out the required visitor credentials and ticket information.</p>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger py-2 small rounded-3 mb-4">
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TicketNumber" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="TicketNumber" class="form-control rounded-3 border-light bg-light py-2" placeholder="e.g. TICK-1001" />
                <span asp-validation-for="TicketNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EventName" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="EventName" class="form-control rounded-3 border-light bg-light py-2" placeholder="e.g. Tech Summit 2026" />
                <span asp-validation-for="EventName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="FirstName" class="form-control rounded-3 border-light bg-light py-2" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="LastName" class="form-control rounded-3 border-light bg-light py-2" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Organization" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="Organization" class="form-control rounded-3 border-light bg-light py-2" placeholder="Company or Institution" />
                <span asp-validation-for="Organization" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ContactNumber" class="form-label fw-semibold small text-muted"></label>
                <input asp-for="ContactNumber" class="form-control rounded-3 border-light bg-light py-2" placeholder="+63..." />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
            <input asp-for="Email" class="form-control rounded-3 border-light bg-light py-2" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Notes" class="form-label fw-semibold small text-muted"></label>
            <textarea asp-for="Notes" class="form-control rounded-3 border-light bg-light" rows="2" placeholder="Optional comments or notes..."></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold py-2">Save Record</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
        </div>
    </form>
</div>